# Client ID van je app op https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=
# Optioneel: standaard is dit de URL waarop de app draait (bv. http://127.0.0.1:5173/)
# Moet exact overeenkomen met een Redirect URI in het Spotify-dashboard.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
